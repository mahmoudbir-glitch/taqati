{
  "name": "@taqati/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma.config.ts",
    "build": "prisma generate --config prisma.config.ts && tsc -p tsconfig.json",
    "typecheck": "prisma validate --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "dotenv": "^17.2.2",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
