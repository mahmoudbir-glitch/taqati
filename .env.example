# PostgreSQL
DATABASE_URL=postgresql://taqati:taqati@localhost:5432/taqati

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Development only: create the site/gateway rows for any gateway that publishes.
# Leave unset in production, where gateways must be registered first.
AUTO_PROVISION_GATEWAYS=true

# Gateway identity
SITE_ID=development-site
GATEWAY_ID=development-gateway
MOCK_TELEMETRY=true

# Web -> API live telemetry
NEXT_PUBLIC_TAQATI_API_URL=http://localhost:4000
NEXT_PUBLIC_TAQATI_SITE_ID=development-site

# --- Web app without a separate API (e.g. on Vercel) -------------------------
# When NEXT_PUBLIC_TAQATI_API_URL is not set, the web app reads SmartESS itself
# from SMARTESS_USERNAME / SMARTESS_PASSWORD below, and only for signed-in
# visitors. Set these in the hosting platform's environment, never in git.
# Password of the site's sign-in screen (at least 8 characters). Required.
TAQATI_PASSWORD=
# Optional: signs the session cookie. Defaults to a key derived from TAQATI_PASSWORD.
# AUTH_SECRET=

# Admin token for the endpoints that change configuration (saving the SmartESS
# account from the settings page). At least 16 characters; unset = saving is closed.
ADMIN_TOKEN=
# Key used to encrypt the stored SmartESS password. Falls back to ADMIN_TOKEN;
# changing it means the account has to be saved again.
# SMARTESS_CONFIG_SECRET=

# SmartESS cloud polling from the environment (optional). An account saved from
# the settings page takes priority over these. Real values go in a secret store only.
SMARTESS_ENABLED=false
SMARTESS_USERNAME=
SMARTESS_PASSWORD=
SMARTESS_DEVICE_PN=
# PN followed by 6 hex digits (devcode + devaddr); both are derived from it.
SMARTESS_DEVICE_SN=
# Optional overrides
# SMARTESS_COMPANY_KEY=
# SMARTESS_DEVICE_DEVCODE=
# SMARTESS_DEVICE_DEVADDR=
# SMARTESS_API_BASE=https://api.dessmonitor.com/public/
# SMARTESS_AUTH_ACTION=authSource
# SMARTESS_POLL_INTERVAL_SECONDS=300
# SMARTESS_TIMEZONE_OFFSET=+03:00
