# PostgreSQL
DATABASE_URL=postgresql://taqati:taqati@localhost:5432/taqati

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Development only: create the site/gateway rows for any gateway that publishes.
# Leave unset in production, where gateways must be registered first.
AUTO_PROVISION_GATEWAYS=true

# Gateway identity
SITE_ID=development-site
GATEWAY_ID=development-gateway
MOCK_TELEMETRY=true

# Web -> API live telemetry
NEXT_PUBLIC_TAQATI_API_URL=http://localhost:4000
NEXT_PUBLIC_TAQATI_SITE_ID=development-site

# SmartESS cloud polling (optional). Real values go in env/secret store only.
SMARTESS_ENABLED=false
SMARTESS_USERNAME=
SMARTESS_PASSWORD=
SMARTESS_DEVICE_PN=
# PN followed by 6 hex digits (devcode + devaddr); both are derived from it.
SMARTESS_DEVICE_SN=
# Optional overrides
# SMARTESS_COMPANY_KEY=
# SMARTESS_DEVICE_DEVCODE=
# SMARTESS_DEVICE_DEVADDR=
# SMARTESS_API_BASE=https://api.dessmonitor.com/public/
# SMARTESS_AUTH_ACTION=authSource
# SMARTESS_POLL_INTERVAL_SECONDS=300
# SMARTESS_TIMEZONE_OFFSET=+03:00
